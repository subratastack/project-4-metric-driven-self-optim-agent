# Future local development settings. No application consumes these yet.
# Copy to .env only when setting up approved dependencies/services.
POSTGRES_DB=metric_optimizer
POSTGRES_USER=metric_optimizer
POSTGRES_PASSWORD=project4_local_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://metric_optimizer:project4_local_only@127.0.0.1:5433/metric_optimizer

# MLflow server and model serving are not configured or started by the scaffold.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=project-4-metric-driven-self-optim-agent
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Select model identities only after reviewing their separate weight licenses.
TASK_MODEL=
OPTIMIZER_MODEL=
JUDGE_MODEL=

# Future telemetry configuration; no exporter or collector is running.
OTEL_SERVICE_NAME=project-4-metric-driven-self-optim-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
