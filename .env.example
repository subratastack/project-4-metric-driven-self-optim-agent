# Model strategy settings, consumed by ModelClient and scripts.run_model.
# Copy this file to .env. Values come only from that file, without shell overrides.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

# Required only for LLM_PROVIDER=openrouter. No default model or fallback.
# Set one explicit vendor/model slug. Never commit the actual API key.
OPENROUTER_MODEL=
OPENROUTER_API_KEY=

# Future database settings; the model strategies do not use these.
POSTGRES_DB=metric_optimizer
POSTGRES_USER=metric_optimizer
POSTGRES_PASSWORD=sample_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://metric_optimizer:sample_password@127.0.0.1:5433/metric_optimizer

# MLflow server and model serving are not configured or started by the scaffold.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=project-4-metric-driven-self-optim-agent
# Reserved for future roles; the model strategy does not read these variables.
TASK_MODEL=
OPTIMIZER_MODEL=
JUDGE_MODEL=

# Future telemetry configuration; no exporter or collector is running.
OTEL_SERVICE_NAME=project-4-metric-driven-self-optim-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
